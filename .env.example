# ---------------------------------------------------------------------------
# laos-data-mcp environment configuration
# Copy to `.env` and fill in as needed. ALL values are optional — the server
# runs against the public, no-auth sources out of the box.
# ---------------------------------------------------------------------------

# Optional: only required to enable specific sources
LAOSIS_API_KEY=                 # Request from lsb.gov.la — enables the Laosis adapter
ADB_API_KEY=                    # Optional — for ADB endpoints that accept a key
HDX_APP_ID=                     # Free, no login — enables HDX HAPI indicator values
                                # Generate at https://hapi.humdata.org/docs
WFP_CLIENT_ID=                  # WFP VAM OAuth2 client id (register at https://api.wfp.org/)
WFP_CLIENT_SECRET=              # WFP VAM OAuth2 client secret
MRC_SESSION_TOKEN=              # Mekong River Commission portal token (free registration)
COMTRADE_API_KEY=               # Optional — enables the full UN Comtrade API endpoint
CENSUS_2025_AVAILABLE=          # Set "true" once the 2025 Lao census results are published

# Cache configuration
CACHE_ENABLED=true              # Set to "false" to disable caching (useful for dev)
CACHE_MAX_KEYS=1000             # Max number of keys held in the in-memory cache

# Circuit breaker — keeps a flaky/down upstream from being hammered
CIRCUIT_BREAKER_ENABLED=true    # Set to "false" to disable per-source circuit breaking
CIRCUIT_FAILURE_THRESHOLD=5     # Consecutive upstream failures before a source's circuit opens
CIRCUIT_COOLDOWN_MS=30000       # How long the circuit stays open before a single probe (ms)

# Transport
MCP_TRANSPORT=stdio             # "stdio" (local) or "http" (remote deployment)
MCP_HTTP_PORT=3000              # Only used when MCP_TRANSPORT=http

# HTTP transport security (only used when MCP_TRANSPORT=http)
MCP_HTTP_HOST=127.0.0.1                 # Bind address — keep on loopback unless intentionally exposing
MCP_HTTP_AUTH_TOKEN=                    # When set, clients must send "Authorization: Bearer <token>"
MCP_HTTP_MAX_BODY_BYTES=1048576         # Max request body size in bytes (default 1 MiB)
MCP_HTTP_DNS_REBINDING_PROTECTION=true  # Validate Host/Origin against the allowlists below
MCP_HTTP_ALLOWED_HOSTS=                 # Comma-separated Host allowlist (default: bind host + localhost)
MCP_HTTP_ALLOWED_ORIGINS=               # Comma-separated Origin allowlist (e.g. https://app.example.com)

# Logging
LOG_LEVEL=info                  # "debug" | "info" | "warn" | "error"
