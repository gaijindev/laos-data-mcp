# ---------------------------------------------------------------------------
# laos-data-mcp environment configuration
# Copy to `.env` and fill in as needed. ALL values are optional — the server
# runs against the public, no-auth sources (World Bank, UNICEF, OD Mekong)
# out of the box.
# ---------------------------------------------------------------------------

# Optional: only required to enable specific sources
LAOSIS_API_KEY=                 # Request from lsb.gov.la — enables the Laosis adapter
ADB_API_KEY=                    # Optional — for ADB endpoints that accept a key
HDX_APP_ID=                     # Free, no login — enables HDX HAPI indicator values
                                # Generate at https://hapi.humdata.org/docs
WFP_CLIENT_ID=                  # WFP VAM OAuth2 client id (register at https://api.wfp.org/)
WFP_CLIENT_SECRET=              # WFP VAM OAuth2 client secret
MRC_SESSION_TOKEN=              # Mekong River Commission portal token (free registration)
CENSUS_2025_AVAILABLE=          # Set "true" once the 2025 Lao census results are published

# Cache configuration
CACHE_ENABLED=true              # Set to "false" to disable caching (useful for dev)
CACHE_MAX_KEYS=1000             # Max number of keys held in the in-memory cache

# Transport
MCP_TRANSPORT=stdio             # "stdio" (local) or "http" (remote deployment)
MCP_HTTP_PORT=3000              # Only used when MCP_TRANSPORT=http

# Logging
LOG_LEVEL=info                  # "debug" | "info" | "warn" | "error"
